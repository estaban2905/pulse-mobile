{
  "name": "pulse-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "start:go": "expo start --go --lan",
    "start:clear": "expo start --go --lan --clear",
    "start:tunnel": "expo start --go --tunnel",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build:apk": "npx --yes eas-cli@latest build --platform android --profile preview",
    "build:aab": "npx --yes eas-cli@latest build --platform android --profile production",
    "build:configure": "npx --yes eas-cli@latest build:configure",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/slider": "5.2.0",
    "expo": "57.0.12",
    "expo-asset": "~57.0.10",
    "expo-audio": "57.0.3",
    "expo-build-properties": "~57.0.10",
    "expo-constants": "~57.0.10",
    "expo-file-system": "~57.0.2",
    "expo-font": "~57.0.1",
    "expo-image": "~57.0.2",
    "expo-linking": "~57.0.5",
    "expo-router": "~57.0.12",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.6",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "typescript": "~6.0.3"
  }
}
