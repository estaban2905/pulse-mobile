{
  "expo": {
    "name": "Pulse Music",
    "slug": "maxi",
    "version": "1.0.0",
    "platforms": [
      "android",
      "ios"
    ],
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "pulsemusic",
    "icon": "./assets/images/icon.png",
    "extra": {
      "eas": {
        "projectId": "5c47d41f-1d90-4485-a07f-c6951da8a3d5"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "music.pulse.app",
      "buildNumber": "1"
    },
    "android": {
      "package": "music.pulse.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "monochromeImage": "./assets/images/adaptive-icon-monochrome.png",
        "backgroundColor": "#0B0B0F"
      }
    },
    "plugins": [
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true,
          "enableBackgroundRecording": false,
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-router",
      [
        "react-native-google-cast",
        {
          "receiverAppId": "CC1AD845",
          "expandedController": true,
          "iosStartDiscoveryAfterFirstTapOnCastButton": true,
          "iosSuspendSessionsWhenBackgrounded": false
        }
      ],
      "expo-status-bar",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0B0F",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "dark": {
            "backgroundColor": "#0B0B0F",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ]
    ],
    "owner": "maxpobletes-team"
  }
}
